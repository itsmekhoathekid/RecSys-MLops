  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(recsys_prompt_safety_detections_total) or vector(0)"
        }
      ],
      "title": "Observe-only detections / 30m",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(recsys_prompt_safety_detections_total) by (category) or vector(0)",
          "legendFormat": "{{category}}"
        }
      ],
      "options": {
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "pieType": "donut"
      },
      "title": "Category distribution",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "No data"
                },
                "1": {
                  "color": "green",
                  "text": "Collector up"
                }
              },
              "type": "value"
            }
          ]
        }
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "min(up{job=\"recsys-otel-collector\"}) or vector(0)"
        }
      ],
      "title": "Redaction pipeline health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 35
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(recsys_prompt_safety_detections_total) by (category)",
          "legendFormat": "{{category}}"
        }
      ],
      "title": "Cumulative detections by category",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 5,
      "targets": [
        {
          "expr": "timestamp(recsys_prompt_safety_detections_total)",
          "format": "table",
          "instant": true
        }
      ],
      "title": "Latest synthetic detections (timestamp / category / action only)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": false,
              "Value": true
            },
            "indexByName": {},
            "renameByName": {
              "Time": "Timestamp",
              "action": "Action",
              "category": "Category"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 6,
      "targets": [
        {
          "expr": "count(count by (category) (recsys_prompt_safety_detections_total)) or vector(0)"
        }
      ],
      "title": "Categories currently exported (expected 4; no prompt or detected value stored)",
      "type": "gauge"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 40,
  "tags": [
    "recsys",
    "safety",
    "pii",
    "observe-only"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "namespace",
        "query": {
          "query": "label_values(up, namespace)",
          "refId": "v1"
        },
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "agent",
        "query": {
          "query": "label_values(recsys_agent_calls_total, agent)",
          "refId": "v2"
        },
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "model",
        "query": {
          "query": "label_values(up{job=\"recsys-llama-cpp\"}, model)",
          "refId": "v3"
        },
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "tool",
        "query": {
          "query": "label_values(recsys_agent_tool_calls_total, tool)",
