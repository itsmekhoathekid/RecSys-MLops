---
# Source: llm-d-modelservice/templates/decode-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: qwen3-5--5a687092-3-5-0-8b-decode
  labels:
    helm.sh/chart: llm-d-modelservice-v0.4.15
    app.kubernetes.io/version: "v0.4.0"
    app.kubernetes.io/managed-by: Helm
spec:
  replicas: 2
  selector:
    matchLabels:
      llm-d.ai/guide: cpu
      llm-d.ai/inference-serving: "true"
      llm-d.ai/inferenceServing: "true"
      llm-d.ai/model: qwen3-5--5a687092-3-5-0-8b
      llm-d.ai/role: decode
  template:
    metadata:
      labels:
        llm-d.ai/guide: cpu
        llm-d.ai/inference-serving: "true"
        llm-d.ai/inferenceServing: "true"
        llm-d.ai/model: qwen3-5--5a687092-3-5-0-8b
        llm-d.ai/role: decode
    spec:
      initContainers:
        - name: routing-proxy
          args:
            - --port=8000
            - --vllm-port=8200
            - --connector=nixlv2
            - --zap-encoder=json
            - --zap-log-level=debug
            - --secure-proxy=false
          image: ghcr.io/llm-d/llm-d-router-disagg-sidecar:v0.9.0
          imagePullPolicy: Always
          ports:
            - containerPort: 8000
          resources: {}
          restartPolicy: Always
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
    
      schedulerName: default-scheduler
      serviceAccountName: qwen3-5--5a687092-3-5-0-8b
      
      volumes:
        - emptyDir:
            medium: Memory
            sizeLimit: 16Gi
          name: dshm
        - configMap:
            defaultMode: 320
            name: llm-d-benchmark-preprocesses
          name: preprocesses
        - name: k8s-llmdbench-context
          secret:
            secretName: llmdbench-context
      
        - name: model-storage
          persistentVolumeClaim:
            claimName: model-pvc
            readOnly: true
      
      containers:
        - name: vllm
          image: public.ecr.aws/q9t5s3a7/vllm-cpu-release-repo:v0.26.0
            
          livenessProbe:
            failureThreshold: 10
            periodSeconds: 5
            tcpSocket:
              port: 8200
            timeoutSeconds: 15
          readinessProbe:
            failureThreshold: 10
            httpGet:
              path: /health
              port: 8200
            periodSeconds: 5
            timeoutSeconds: 15
          startupProbe:
            failureThreshold: 60
            httpGet:
              path: /health
              port: 8200
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
          imagePullPolicy: IfNotPresent
          
          command:
            - /bin/bash
            - -c
          args:
            - |
              python3 /setup/preprocess/set_llmdbench_environment.py && . $HOME/llmdbench_env.sh; vllm serve /model-cache/models/qwen3.5-0.8b \
                --host 0.0.0.0 \
                --served-model-name qwen3.5-0.8b \
                --port $VLLM_METRICS_PORT \
                --block-size $VLLM_BLOCK_SIZE \
                --max-model-len $VLLM_MAX_MODEL_LEN \
                --tensor-parallel-size $VLLM_TENSOR_PARALLELISM \
                --no-enable-log-requests \
                --disable-uvicorn-access-log \
                --no-enable-prefix-caching
          env:
          - name: VLLM_IS_DECODE
            value: "1"
          - name: HOME
            value: /tmp
          - name: USER
            value: llm-d
          - name: HF_HOME
            value: /tmp/huggingface
          - name: MODEL_NAME
            value: qwen3.5-0.8b
          - name: MODEL_PATH
            value: models/qwen3.5-0.8b
          - name: VLLM_CACHE_ROOT
            value: /tmp/vllm
          - name: VLLM_WORKER_MULTIPROC_METHOD
            value: spawn
          - name: VLLM_LOGGING_LEVEL
            value: INFO
          - name: VLLM_HTTP_TIMEOUT_KEEP_ALIVE
            value: "120"
          - name: VLLM_ALLOW_LONG_MAX_MODEL_LEN
            value: "1"
          - name: VLLM_SERVER_DEV_MODE
            value: "1"
          - name: VLLM_INFERENCE_PORT
            value: "8000"
          - name: VLLM_METRICS_PORT
            value: "8200"
          - name: VLLM_BLOCK_SIZE
            value: "64"
          - name: VLLM_MAX_MODEL_LEN
            value: "1024"
          - name: VLLM_LOAD_FORMAT
            value: auto
          - name: VLLM_ACCELERATOR_MEM_UTIL
            value: "0"
          - name: VLLM_MAX_NUM_SEQ
            value: "256"
          - name: VLLM_TENSOR_PARALLELISM
            value: "1"
          - name: VLLM_MAX_NUM_BATCHED_TOKENS
            value: "256"
          - name: VLLM_NIXL_SIDE_CHANNEL_HOST
            valueFrom:
              fieldRef:
                fieldPath: status.podIP
          - name: VLLM_NIXL_SIDE_CHANNEL_PORT
            value: "5557"
          - name: UCX_TLS
            value: sm,cuda_ipc,cuda_copy,tcp
          - name: UCX_SOCKADDR_TLS_PRIORITY
            value: tcp
          - name: POD_IP
            valueFrom:
              fieldRef:
                apiVersion: v1
                fieldPath: status.podIP
          - name: LLMDBENCH_POD_NS
            valueFrom:
              fieldRef:
                fieldPath: metadata.namespace
          - name: DP_SIZE
            value: "1"
          - name: TP_SIZE
            value: "1"
          - name: DP_SIZE_LOCAL
            value: "1"
          
          
          resources:
            limits:
              cpu: "8"
              memory: 32Gi
            requests:
              cpu: "8"
              memory: 32Gi
          
          volumeMounts:
            - mountPath: /dev/shm
              name: dshm
            - mountPath: /setup/preprocess
              name: preprocesses
            - mountPath: /etc/kubeconfig
              name: k8s-llmdbench-context
              readOnly: true
            - name: model-storage
              mountPath: /model-cache
              readOnly: true

