{
  "version": 4,
  "globalExcludes": [
    "docs/**",
    "graphify-out/**",
    "*.md",
    "*.rst",
    "**/*.md",
    "**/*.rst",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.svg",
    "**/*.webp",
    "**/*.pyc",
    "**/__pycache__/**",
    "**/__init__.py",
    ".DS_Store",
    "**/.DS_Store",
    ".coverage",
    ".gitignore",
    "**/.gitkeep",
    ".idea/**",
    ".vscode/**",
    ".ci-image-manifest/**",
    ".ci-deploy/**",
    ".ci-release-plan.json",
    "reports/**"
  ],
  "pathGroups": {
    "python-common": {
      "files": [
        "pyproject.toml",
        "requirements.txt",
        "uv.lock",
        ".python-version"
      ]
    },
    "jenkins-shared-runtime": {
      "prefixes": [
        "jenkins/pipeline/",
        "jenkins/scripts/entrypoints/",
        "jenkins/scripts/lib/",
        "jenkins/scripts/deploy/preflight/"
      ],
      "files": [
        "jenkins/python/configuration.py",
        "jenkins/python/release_plan.py",
        "jenkins/scripts/build/engine.sh",
        "jenkins/scripts/build/runtime.sh",
        "jenkins/scripts/test/runtime.sh"
      ]
    },
    "data-common": {
      "prefixes": [
        "apps/data-platform/src/config/"
      ],
      "files": [
        "apps/data-platform/pyproject.toml",
        "apps/data-platform/uv.lock",
        "tests/contract/test_docker_dataflow_contracts.py"
      ]
    },
    "lakehouse-common": {
      "prefixes": [
        "apps/data-platform/src/lakehouse/"
      ],
      "files": [
        "apps/data-platform/src/validate/governance_contracts.py",
        "tests/unit/data_platform/test_lakehouse_optimization.py",
        "tests/unit/data_platform/test_datahub_catalog.py",
        "tests/integration/test_hudi_native_upsert_versioning.py"
      ]
    },
    "datahub-governance": {
      "prefixes": [
        "apps/data-platform/src/metadata/"
      ],
      "files": [
        "apps/data-platform/src/validate/governance_contracts.py",
        "tests/unit/data_platform/test_datahub_catalog.py",
        "tests/unit/data_platform/test_datahub_dataset_cutover.py"
      ]
    },
    "airflow-data-release": {
      "prefixes": [
        "infra/helm/recsys-airflow/"
      ]
    },
    "spark-utils": {
      "files": [
        "apps/data-platform/src/orchestration/airflow/spark_utils.py"
      ]
    },
    "feature-store-release": {
      "prefixes": [
        "infra/helm/recsys-feature-store/"
      ]
    },
    "streaming-release": {
      "prefixes": [
        "infra/helm/recsys-streaming/",
        "infra/helm/recsys-event-stream/",
        "infra/helm/recsys-kafka-connect/"
      ]
    },
    "rag-shared-runtime": {
      "prefixes": [
        "apps/data-platform/rag-runtime/",
        "configs/data-platform/rag/",
        "scripts/models/"
      ]
    },
    "serving-mutation-common": {
      "files": [
        "jenkins/ServingMutation.Jenkinsfile",
        "tests/mutation/api_serving/run.py"
      ]
    }
  },
  "ciConfiguration": {
    "flag": "RUN_CI_CONFIG",
    "changeDetection": {
      "prefixes": [
        "configs/agentregistry/",
        "configs/kagent/",
        "configs/langfuse/",
        "configs/llm-d/",
        "configs/vault/",
        "infra/terraform/",
        "infra/helm/",
        "infra/helm/recsys-ci/",
        "ops/",
        "jenkins/config/",
        "jenkins/python/",
        "jenkins/scripts/",
        "tests/unit/jenkins/",
        "tests/unit/observability/",
        "tests/mutation/",
        "tests/contract/"
      ],
      "files": [
        ".dockerignore",
        ".gcloudignore",
        "Jenkinsfile",
        "jenkins/ServingMutation.Jenkinsfile",
        "Makefile",
        "infra/__init__.py",
        "tests/contract/test_repository_layout_contracts.py",
        "tests/unit/test_feature_api_keep_post_renderer.py",
        "tests/unit/test_substrate_gke_postrender.py"
      ]
    }
  },
