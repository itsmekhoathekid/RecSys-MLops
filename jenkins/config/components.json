    },
    {
      "name": "stream_online",
      "flag": "RUN_STREAM_ONLINE",
      "label": "Stream Features To Online Store",
      "ciProfile": "data",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime",
          "data-common",
          "feature-store-release",
          "streaming-release"
        ],
        "prefixes": [
          "apps/data-platform/src/features/flink/",
