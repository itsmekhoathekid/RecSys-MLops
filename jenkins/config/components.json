        ]
      },
      "buildImages": [
        "recsys-drift-retrain",
        "recsys-airflow"
      ],
      "buildArtifacts": [],
      "verifyDependsOn": [
        "dp3"
      ],
      "migrationPolicy": "none"
    },
    {
      "name": "stream_offline",
      "flag": "RUN_STREAM_OFFLINE",
      "label": "Stream Features To Offline Store",
      "ciProfile": "data",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime",
          "data-common",
