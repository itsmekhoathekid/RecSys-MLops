{
  "version": 4,
  "globalExcludes": [
    "docs/**",
    "graphify-out/**",
    "*.md",
    "*.rst",
    "**/*.md",
    "**/*.rst",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.svg",
    "**/*.webp",
    "**/*.pyc",
    "**/__pycache__/**",
    "**/__init__.py",
    ".DS_Store",
    "**/.DS_Store",
    ".coverage",
    ".gitignore",
    "**/.gitkeep",
    ".idea/**",
    ".vscode/**",
    ".ci-image-manifest/**",
    ".ci-release-plan.json",
    "reports/**"
  ],
  "pathGroups": {
    "python-common": {
      "files": [
        "pyproject.toml",
        "requirements.txt",
        "uv.lock",
        ".python-version"
      ]
    },
    "jenkins-shared-runtime": {
      "prefixes": [
        "jenkins/pipeline/",
        "jenkins/scripts/entrypoints/",
        "jenkins/scripts/lib/",
        "jenkins/scripts/deploy/preflight/"
      ],
      "files": [
        "jenkins/python/configuration.py",
        "jenkins/python/release_plan.py",
        "jenkins/scripts/build/engine.sh",
        "jenkins/scripts/build/runtime.sh",
        "jenkins/scripts/test/runtime.sh"
      ]
    },
    "data-common": {
      "prefixes": [
        "apps/data-platform/src/config/"
      ],
      "files": [
        "apps/data-platform/pyproject.toml",
        "apps/data-platform/uv.lock",
        "tests/contract/test_docker_dataflow_contracts.py"
      ]
    },
    "lakehouse-common": {
      "prefixes": [
        "apps/data-platform/src/lakehouse/",
        "apps/data-platform/src/metadata/"
      ],
      "files": [
        "apps/data-platform/src/validate/governance_contracts.py",
        "tests/unit/data_platform/test_lakehouse_optimization.py",
        "tests/unit/data_platform/test_governance_lineage.py",
        "tests/unit/test_runtime_lineage.py",
        "tests/integration/test_hudi_native_upsert_versioning.py"
      ]
    },
    "airflow-data-release": {
      "prefixes": [
        "infra/helm/recsys-airflow/"
      ]
    },
    "spark-utils": {
      "files": [
        "apps/data-platform/src/orchestration/airflow/spark_utils.py"
      ]
    },
    "feature-store-release": {
      "prefixes": [
        "infra/helm/recsys-feature-store/"
      ]
    },
    "streaming-release": {
      "prefixes": [
        "infra/helm/recsys-streaming/",
        "infra/helm/recsys-event-stream/",
        "infra/helm/recsys-kafka-connect/"
      ]
    }
  },
  "ciConfiguration": {
    "flag": "RUN_CI_CONFIG",
    "changeDetection": {
      "prefixes": [
        "configs/kagent/",
        "configs/llm-d/",
        "configs/vault/",
        "infra/terraform/",
        "infra/helm/",
        "infra/helm/recsys-ci/",
        "ops/",
        "jenkins/config/",
        "jenkins/python/",
        "jenkins/scripts/",
        "tests/unit/jenkins/",
        "tests/contract/"
      ],
      "files": [
        ".dockerignore",
        ".gcloudignore",
        "Jenkinsfile",
        "Makefile",
        "infra/__init__.py",
        "tests/contract/test_repository_layout_contracts.py",
        "tests/unit/test_feature_api_keep_post_renderer.py"
      ]
    }
  },
  "components": [
    {
      "name": "materialize",
      "flag": "RUN_MATERIALIZE",
      "label": "Materialize Pipeline",
      "ciProfile": "data",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime",
          "data-common",
          "feature-store-release",
          "airflow-data-release",
          "spark-utils"
        ],
        "prefixes": [
          "packages/recsys-feature-store-runtime/",
          "apps/data-platform/feature-store/",
          "apps/data-platform/src/feature_store/",
          "apps/data-platform/src/metadata/",
          "tests/unit/feature_store/"
        ],
        "files": [
          "jenkins/scripts/ci/data.sh",
          "jenkins/scripts/deploy/feast.sh",
          "apps/data-platform/src/orchestration/airflow/dags/recsys_feast_materialize.py"
        ]
      },
      "buildImages": [
        "recsys-feature-store",
        "recsys-airflow"
      ],
      "buildArtifacts": [],
      "verifyDependsOn": [
        "dp3"
      ],
      "migrationPolicy": "none"
    },
    {
      "name": "training",
      "flag": "RUN_TRAINING",
      "label": "Training Pipeline",
      "ciProfile": "ml",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime"
        ],
        "prefixes": [
          "packages/recsys-feature-store-runtime/",
          "apps/ml-system/",
          "configs/ml-system/",
          "infra/helm/mlflow-stack/",
          "infra/helm/ray-cluster/",
          "infra/helm/recsys-runtime/",
          "pipelines/kubeflow/",
          "notebooks/",
          "tests/unit/ml_system/"
        ],
        "files": [
          "jenkins/scripts/ci/ml.sh",
          "jenkins/scripts/build/kfp_package.sh",
          "jenkins/scripts/deploy/upload_kfp_package.sh",
          "jenkins/scripts/deploy/ml_platform.sh",
          "jenkins/scripts/test/ml_platform.sh"
        ]
      },
      "buildImages": [
        "recsys-mlops-training",
        "recsys-spark",
        "recsys-mlflow",
        "recsys-drift-retrain"
      ],
      "buildArtifacts": [
        "kubeflow-bst"
      ],
      "verifyDependsOn": [
        "materialize"
      ],
      "migrationPolicy": "expand-only"
    },
    {
      "name": "dp1",
      "flag": "RUN_DP1",
      "label": "DP1 Raw To Bronze",
      "ciProfile": "data",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime",
          "data-common",
          "lakehouse-common",
          "airflow-data-release",
          "spark-utils"
        ],
        "prefixes": [
          "apps/data-platform/data-generator/",
          "apps/data-platform/src/ingest/",
          "infra/helm/recsys-data-lakehouse/",
          "infra/helm/recsys-source-store/",
          "tests/unit/data_generator/"
        ],
        "files": [
          "configs/data-platform/generator/default.yaml",
          "configs/data-platform/generator/drift.yaml",
          "configs/data-platform/generator/e2e-1k.yaml",
          "configs/data-platform/generator/e2e-2k.yaml",
          "configs/data-platform/spark/dp1.yaml",
          "apps/data-platform/src/orchestration/airflow/dags/recsys_dp1_raw_to_bronze.py"
        ],
        "globs": [
          "apps/data-platform/src/validate/**/*.py"
        ]
      },
      "buildImages": [
        "recsys-spark",
        "recsys-data-ingestion",
        "recsys-kafka-connect",
        "recsys-airflow"
      ],
      "buildArtifacts": [],
      "verifyDependsOn": [],
      "migrationPolicy": "expand-only"
    },
    {
      "name": "dp2",
      "flag": "RUN_DP2",
      "label": "DP2 Bronze To Silver Gold",
      "ciProfile": "data",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime",
          "data-common",
          "lakehouse-common",
          "airflow-data-release",
          "spark-utils"
        ],
        "prefixes": [
          "tests/unit/data_platform/"
        ],
        "files": [
          "configs/data-platform/spark/dp2.yaml",
          "apps/data-platform/src/orchestration/airflow/dags/recsys_dp2_bronze_to_silver_gold.py",
          "apps/data-platform/src/features/spark/dp2_silver_gold_entrypoint.py",
          "apps/data-platform/src/features/spark/build_silver_tables.py"
        ],
        "globs": []
      },
      "buildImages": [
        "recsys-spark",
        "recsys-airflow"
      ],
      "buildArtifacts": [],
      "verifyDependsOn": [
        "dp1"
      ],
      "migrationPolicy": "none"
    },
    {
      "name": "dp3",
      "flag": "RUN_DP3",
      "label": "DP3 Offline Feature Table",
      "ciProfile": "data",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime",
          "data-common",
          "lakehouse-common",
          "airflow-data-release",
          "feature-store-release",
          "spark-utils"
        ],
        "prefixes": [
          "apps/data-platform/src/features/",
          "apps/data-platform/src/feature_store/",
          "apps/data-platform/feature-store/",
          "tests/unit/feature_store/"
        ],
        "files": [
          "configs/data-platform/spark/dp3.yaml",
          "configs/data-platform/spark/dp3-e2e-1k.yaml",
          "configs/data-platform/spark/dp3-e2e-2k.yaml",
          "apps/data-platform/src/orchestration/airflow/dags/recsys_dp3_offline_feature_table.py"
        ],
        "exclude": [
          "apps/data-platform/src/features/spark/dp2_silver_gold_entrypoint.py",
          "apps/data-platform/src/features/spark/build_silver_tables.py"
        ]
      },
      "buildImages": [
        "recsys-spark",
        "recsys-feature-store",
        "recsys-airflow"
      ],
      "buildArtifacts": [],
      "verifyDependsOn": [
        "dp2"
      ],
      "migrationPolicy": "expand-only"
    },
    {
      "name": "online_feature_api",
      "flag": "RUN_ONLINE_FEATURE_API",
      "label": "Online Feature API",
      "ciProfile": "online-feature-api",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime"
        ],
        "prefixes": [
          "apps/api-serving/shared/",
          "apps/api-serving/online-feature-api/",
          "packages/recsys-feature-store-runtime/",
          "infra/helm/recsys-online-feature-api/",
          "tests/unit/api_serving/"
        ],
        "files": [
          "tests/contract/test_stream_online_serving_contract.py",
          "jenkins/scripts/ci/serving.sh",
          "jenkins/scripts/deploy/serving.sh",
          "jenkins/scripts/test/serving.sh",
          "tests/contract/test_serving_contracts.py"
        ]
      },
      "buildImages": [
        "recsys-online-feature-api"
      ],
      "buildArtifacts": [],
      "verifyDependsOn": [
        "materialize"
      ],
      "migrationPolicy": "none"
    },
    {
      "name": "inference_api",
      "flag": "RUN_INFERENCE_API",
      "label": "Inference API",
      "ciProfile": "inference-api",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime"
        ],
        "prefixes": [
          "apps/api-serving/shared/",
          "apps/api-serving/inference-api/",
          "infra/helm/recsys-inference-api/",
          "infra/helm/recsys-gateway/",
          "tests/e2e/",
          "tests/unit/api_serving/"
        ],
        "files": [
          "jenkins/scripts/ci/serving.sh",
          "jenkins/scripts/deploy/serving.sh",
          "jenkins/scripts/test/serving.sh",
          "tests/contract/test_gateway_contracts.py",
          "tests/contract/test_observability_contracts.py",
          "tests/contract/test_serving_contracts.py"
        ]
      },
      "buildImages": [
        "recsys-inference-api"
      ],
      "buildArtifacts": [],
      "verifyDependsOn": [],
      "migrationPolicy": "none"
    },
    {
      "name": "kserve",
      "flag": "RUN_KSERVE",
      "label": "KServe Inference Engine",
      "ciProfile": "ml",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime"
        ],
        "prefixes": [
          "infra/helm/recsys-serving/",
          "jenkins/python/model_cd/",
          "tests/e2e/"
        ],
        "files": [
          "jenkins/scripts/deploy/serving.sh",
          "jenkins/scripts/test/serving.sh",
          "tests/contract/test_observability_contracts.py",
          "tests/contract/test_serving_contracts.py",
          "apps/ml-system/src/registry/model_promotion.py"
        ]
      },
      "buildImages": [],
      "buildArtifacts": [],
      "verifyDependsOn": [
        "training"
      ],
      "migrationPolicy": "none"
    },
    {
      "name": "rollout",
      "flag": "RUN_ROLLOUT",
      "label": "Progressive Model Rollout",
      "ciProfile": "ml",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime"
        ],
        "prefixes": [
          "jenkins/python/model_cd/",
          "tests/load/"
        ],
        "files": [
          "apps/ml-system/src/cli/model_rollout_controller.py",
          "apps/ml-system/src/cli/trigger_kserve_cd.py",
          "jenkins/KServeModelCD.Jenkinsfile",
          "jenkins/scripts/deploy/rollout.sh",
          "jenkins/scripts/test/champion_only.sh",
          "tests/unit/ml_system/test_model_rollout_controller.py",
          "tests/unit/ml_system/test_kserve_cd_trigger.py",
          "tests/contract/test_observability_contracts.py",
          "tests/contract/test_serving_contracts.py"
        ]
      },
      "buildImages": [
        "recsys-mlops-training"
      ],
      "buildArtifacts": [],
      "verifyDependsOn": [
        "kserve"
      ],
      "migrationPolicy": "none"
    },
    {
      "name": "drift",
      "flag": "RUN_DRIFT",
      "label": "Realtime Drift Detection",
      "ciProfile": "data",
      "changeDetection": {
        "groups": [
          "python-common",
          "jenkins-shared-runtime",
          "data-common",
          "airflow-data-release",
          "spark-utils"
        ],
        "prefixes": [
          "apps/data-platform/data-generator/src/drift/",
          "apps/data-platform/src/mlops/",
          "apps/data-platform/src/monitoring/",
