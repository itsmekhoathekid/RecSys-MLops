index 00000000..1c44b314
--- /dev/null
+++ b/go/adk/pkg/agent/explicit_tool_selection_guard.go
@@ -0,0 +1,216 @@
+// Copyright 2026 The Kagent Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package agent
+
+import (
+	"encoding/json"
+	"strings"
+	"sync"
+
+	"github.com/go-logr/logr"
+	adkagent "google.golang.org/adk/v2/agent"
+	adkmodel "google.golang.org/adk/v2/model"
+	"google.golang.org/genai"
+)
+
+var coordinatorSelectableTools = []string{
+	"kagent__NS__recsys_context_agent_sandbox",
+	"kagent__NS__recsys_recommendation_agent_sandbox",
+	"get_chunk_by_id",
+	"get_personalized_recommendations",
+}
+
+type explicitToolSelection struct {
+	allowed map[string]bool
+	prompt  string
+	seen    map[string]bool
+	results []toolResult
+}
+
+// explicitToolSelectionGuard makes explicit coordinator smoke/API contracts
+// deterministic on small models. If the current user turn names one or more
+// Agent tools, only those Agent tools may execute. Otherwise, explicitly named
+// raw MCP tools are allowed. Turns that do not name a tool are left untouched.
+type explicitToolSelectionGuard struct {
+	log        logr.Logger
+	mu         sync.Mutex
+	selections map[string]explicitToolSelection
+}
+
+func newExplicitToolSelectionGuard(log logr.Logger) *explicitToolSelectionGuard {
+	return &explicitToolSelectionGuard{
+		log:        log,
+		selections: make(map[string]explicitToolSelection),
+	}
+}
+
+func (g *explicitToolSelectionGuard) BeforeModel(ctx adkagent.Context, req *adkmodel.LLMRequest) (*adkmodel.LLMResponse, error) {
+	if ctx == nil || req == nil || ctx.InvocationID() == "" {
+		return nil, nil
+	}
+	prompt := latestUserText(req.Contents)
+	if prompt == "" {
+		return nil, nil
+	}
+	allowed := make(map[string]bool)
+	for _, name := range coordinatorSelectableTools[:2] {
+		if strings.Contains(prompt, name) {
+			allowed[name] = true
+		}
+	}
+	if len(allowed) == 0 {
+		for _, name := range coordinatorSelectableTools[2:] {
+			if strings.Contains(prompt, name) {
+				allowed[name] = true
+			}
+		}
+	}
+	g.mu.Lock()
+	if len(allowed) == 0 {
+		delete(g.selections, ctx.InvocationID())
+	} else {
+		selection, exists := g.selections[ctx.InvocationID()]
+		if !exists || selection.prompt != prompt {
+			selection = explicitToolSelection{
+				allowed: allowed,
+				prompt:  prompt,
+				seen:    make(map[string]bool),
+			}
+		} else {
+			selection.allowed = allowed
+		}
+		if results := functionResponses(req.Contents); len(results) > 0 {
+			selection.results = results
+		}
+		g.selections[ctx.InvocationID()] = selection
+	}
+	g.mu.Unlock()
+	return nil, nil
+}
+
+func (g *explicitToolSelectionGuard) AfterModel(ctx adkagent.Context, resp *adkmodel.LLMResponse, modelErr error) (*adkmodel.LLMResponse, error) {
+	if ctx == nil || ctx.InvocationID() == "" {
+		return nil, nil
+	}
+	invocationID := ctx.InvocationID()
+	if modelErr != nil || resp == nil {
+		g.forget(invocationID)
+		return nil, nil
+	}
+	if resp.Partial || resp.Content == nil {
+		return nil, nil
+	}
+
+	g.mu.Lock()
+	selection, selected := g.selections[invocationID]
+	g.mu.Unlock()
+	if !selected {
+		return nil, nil
+	}
+
+	filtered := make([]*genai.Part, 0, len(resp.Content.Parts))
+	removed := make([]string, 0)
+	allowedCalls := 0
+	for _, part := range resp.Content.Parts {
+		if part == nil || part.FunctionCall == nil {
+			filtered = append(filtered, part)
+			continue
+		}
+		if selection.allowed[part.FunctionCall.Name] && !selection.seen[part.FunctionCall.Name] {
+			allowedCalls++
+			selection.seen[part.FunctionCall.Name] = true
+			filtered = append(filtered, part)
+		} else {
+			removed = append(removed, part.FunctionCall.Name)
+		}
+	}
+	g.mu.Lock()
+	g.selections[invocationID] = selection
+	g.mu.Unlock()
+	if len(removed) == 0 {
+		if allowedCalls == 0 {
+			g.forget(invocationID)
+		}
+		return nil, nil
+	}
+
+	g.log.Info("Filtered tool calls outside explicit coordinator selection",
+		"invocationID", invocationID, "removedTools", removed)
+	if allowedCalls == 0 {
+		for name := range selection.allowed {
+			if selection.seen[name] {
+				continue
+			}
+			if strings.HasPrefix(name, "kagent__NS__") {
+				selection.seen[name] = true
+				g.mu.Lock()
+				g.selections[invocationID] = selection
+				g.mu.Unlock()
+				return &adkmodel.LLMResponse{
+					Content: genai.NewContentFromFunctionCall(
+						name, map[string]any{"request": missingAgentRequest(selection)}, genai.RoleModel,
+					),
+				}, nil
+			}
+		}
+		g.forget(invocationID)
+		return &adkmodel.LLMResponse{
+			Content:      genai.NewContentFromText(duplicateToolFallbackText(removed, selection.results), genai.RoleModel),
+			FinishReason: genai.FinishReasonStop,
+		}, nil
+	}
+
+	replacement := *resp
+	content := *resp.Content
+	content.Parts = filtered
+	replacement.Content = &content
+	return &replacement, nil
+}
+
+func missingAgentRequest(selection explicitToolSelection) string {
+	resultText := "none"
+	if raw, err := json.Marshal(selection.results); err == nil && len(raw) > 0 {
+		resultText = string(raw)
+	}
+	return "Continue the explicitly requested coordinator flow without repeating a completed tool. " +
+		"Use these completed tool results to preserve user_id, item order, and returned item IDs: " +
+		resultText + ". Original request: " + selection.prompt
+}
+
+func (g *explicitToolSelectionGuard) forget(invocationID string) {
+	g.mu.Lock()
+	delete(g.selections, invocationID)
+	g.mu.Unlock()
+}
+
+func latestUserText(contents []*genai.Content) string {
+	for index := len(contents) - 1; index >= 0; index-- {
+		content := contents[index]
+		if content == nil || content.Role != genai.RoleUser {
+			continue
+		}
+		var text strings.Builder
+		for _, part := range content.Parts {
+			if part != nil && part.Text != "" {
+				text.WriteString(part.Text)
+				text.WriteByte('\n')
+			}
+		}
+		if text.Len() > 0 {
+			return text.String()
+		}
+	}
+	return ""
+}
