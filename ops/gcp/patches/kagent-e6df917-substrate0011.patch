+func TestExplicitToolSelectionGuardPreservesRecommendationAfterContextFailure(t *testing.T) {
+	ctx := &duplicateGuardContext{invocationID: "invocation-partial"}
+	guard := newExplicitToolSelectionGuard(logr.Discard())
+	prompt := "Directly call get_chunk_by_id and get_personalized_recommendations."
+	request := &adkmodel.LLMRequest{Contents: []*genai.Content{genai.NewContentFromText(prompt, genai.RoleUser)}}
+	_, _ = guard.BeforeModel(ctx, request)
+	chunkCall := &adkmodel.LLMResponse{Content: genai.NewContentFromFunctionCall(
+		"get_chunk_by_id", map[string]any{"chunk_id": "missing"}, genai.RoleModel,
+	)}
+	if replacement, err := guard.AfterModel(ctx, chunkCall, nil); err != nil || replacement != nil {
+		t.Fatalf("chunk call replacement=%#v err=%v", replacement, err)
+	}
+	request.Contents = append(request.Contents, &genai.Content{Role: genai.RoleUser, Parts: []*genai.Part{
+		genai.NewPartFromFunctionResponse("get_chunk_by_id", map[string]any{"error": "not found"}),
+	}})
+	_, _ = guard.BeforeModel(ctx, request)
+	recommendationCall := &adkmodel.LLMResponse{Content: genai.NewContentFromFunctionCall(
+		"get_personalized_recommendations", map[string]any{"user_id": 1001}, genai.RoleModel,
+	)}
+	if replacement, err := guard.AfterModel(ctx, recommendationCall, nil); err != nil || replacement != nil {
+		t.Fatalf("recommendation call replacement=%#v err=%v", replacement, err)
+	}
+	request.Contents = append(request.Contents, &genai.Content{Role: genai.RoleUser, Parts: []*genai.Part{
+		genai.NewPartFromFunctionResponse("get_personalized_recommendations", map[string]any{
+			"output": map[string]any{"items": []any{map[string]any{"item_id": float64(800035)}}},
+		}),
+	}})
+	_, _ = guard.BeforeModel(ctx, request)
+	replacement, err := guard.AfterModel(ctx, &adkmodel.LLMResponse{Content: &genai.Content{Role: genai.RoleModel}}, nil)
+	if err != nil || replacement == nil || replacement.Content == nil {
+		t.Fatalf("terminal replacement=%#v err=%v", replacement, err)
+	}
+	if got := replacement.Content.Parts[0].Text; got != "Recommended item_id: 800035. Context source unavailable." {
+		t.Fatalf("terminal text=%q", got)
+	}
+}
