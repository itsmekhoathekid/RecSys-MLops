+
+func TestExplicitToolSelectionGuardKeepsOnlyNamedAgent(t *testing.T) {
+	ctx := &duplicateGuardContext{invocationID: "invocation-1"}
+	guard := newExplicitToolSelectionGuard(logr.Discard())
+	prompt := "Call exactly kagent__NS__recsys_context_agent_sandbox; child uses get_user_online_features."
+	request := &adkmodel.LLMRequest{Contents: []*genai.Content{genai.NewContentFromText(prompt, genai.RoleUser)}}
+	if replacement, err := guard.BeforeModel(ctx, request); err != nil || replacement != nil {
+		t.Fatalf("before model replacement=%#v err=%v", replacement, err)
+	}
+	response := &adkmodel.LLMResponse{Content: &genai.Content{Role: genai.RoleModel, Parts: []*genai.Part{
+		genai.NewPartFromFunctionCall("kagent__NS__recsys_context_agent_sandbox", map[string]any{"request": "context"}),
+		genai.NewPartFromFunctionCall("kagent__NS__recsys_recommendation_agent_sandbox", map[string]any{"request": "recommend"}),
+		genai.NewPartFromFunctionCall("get_personalized_recommendations", map[string]any{"user_id": 1001}),
+	}}}
+	replacement, err := guard.AfterModel(ctx, response, nil)
+	if err != nil || replacement == nil {
+		t.Fatalf("after model replacement=%#v err=%v", replacement, err)
+	}
+	calls := functionCallSignatures(replacement.Content)
+	if len(calls) != 1 {
+		t.Fatalf("calls=%v, want exactly one", calls)
+	}
+	for _, name := range calls {
+		if name != "kagent__NS__recsys_context_agent_sandbox" {
+			t.Fatalf("kept tool=%s, want context agent", name)
+		}
+	}
+}
