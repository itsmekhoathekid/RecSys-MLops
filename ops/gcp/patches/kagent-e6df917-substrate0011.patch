diff --git a/go/adk/pkg/agent/duplicate_tool_call_guard.go b/go/adk/pkg/agent/duplicate_tool_call_guard.go
new file mode 100644
index 00000000..ccee0be0
--- /dev/null
+++ b/go/adk/pkg/agent/duplicate_tool_call_guard.go
@@ -0,0 +1,250 @@
+// Copyright 2026 The Kagent Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package agent
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/go-logr/logr"
+	adkagent "google.golang.org/adk/v2/agent"
+	adkmodel "google.golang.org/adk/v2/model"
+	"google.golang.org/genai"
+)
+
+const (
+	duplicateToolResultLimit = 12000
+	duplicateToolStateTTL    = time.Hour
+)
+
+// duplicateToolCallGuard prevents an LLM from executing the same tool with
+// the same arguments more than once in a single invocation. The Google ADK
+// normal (non-live) runner has no tool-round limit; after a partial tool failure
+// some models can therefore retry an identical set forever. The first call and
+// every call with different arguments are unaffected.
+//
+// The guard keeps short-lived state itself rather than reading Session.Events:
+// the runner does not guarantee that just-yielded tool events are visible in
+// the session before the next model callback.
+type duplicateToolCallGuard struct {
+	log         logr.Logger
+	mu          sync.Mutex
+	invocations map[string]*duplicateToolInvocation
+}
+
+type duplicateToolInvocation struct {
+	signatures map[string]bool
+	results    []toolResult
+	lastSeen   time.Time
+}
+
+func newDuplicateToolCallGuard(log logr.Logger) *duplicateToolCallGuard {
+	return &duplicateToolCallGuard{
+		log:         log,
+		invocations: make(map[string]*duplicateToolInvocation),
+	}
+}
+
+// BeforeModel captures the function responses that the model sees after a tool
+// round. They are later used to build a terminal partial-result response if the
+// model emits an exact duplicate call.
+func (g *duplicateToolCallGuard) BeforeModel(ctx adkagent.Context, req *adkmodel.LLMRequest) (*adkmodel.LLMResponse, error) {
+	if ctx == nil || req == nil || ctx.InvocationID() == "" {
+		return nil, nil
+	}
+	results := functionResponses(req.Contents)
+	if len(results) == 0 {
+		return nil, nil
+	}
+	g.mu.Lock()
+	state := g.invocation(ctx.InvocationID())
+	state.results = results
+	g.mu.Unlock()
+	return nil, nil
+}
+
+// AfterModel records the first set of calls and replaces any later exact retry
+// with a final text response before ADK can execute the duplicate side effect.
+func (g *duplicateToolCallGuard) AfterModel(ctx adkagent.Context, resp *adkmodel.LLMResponse, modelErr error) (*adkmodel.LLMResponse, error) {
+	if ctx == nil || ctx.InvocationID() == "" {
+		return nil, nil
+	}
+	invocationID := ctx.InvocationID()
+	if modelErr != nil || resp == nil {
+		g.forget(invocationID)
+		return nil, nil
+	}
+	if resp.Partial || resp.Content == nil {
+		return nil, nil
+	}
+
+	current := functionCallSignatures(resp.Content)
+	if len(current) == 0 {
+		g.forget(invocationID)
+		return nil, nil
+	}
+
+	g.mu.Lock()
+	state := g.invocation(invocationID)
+	var duplicates []string
+	for signature, name := range current {
+		if state.signatures[signature] {
+			duplicates = append(duplicates, name)
+		}
+	}
+	if len(duplicates) == 0 {
+		for signature := range current {
+			state.signatures[signature] = true
+		}
+		g.mu.Unlock()
+		return nil, nil
+	}
+	results := append([]toolResult(nil), state.results...)
+	delete(g.invocations, invocationID)
+	g.mu.Unlock()
+
+	sort.Strings(duplicates)
+	g.log.Info("Suppressing duplicate tool-call loop", "invocationID", invocationID, "tools", duplicates)
+	return &adkmodel.LLMResponse{
+		Content:      genai.NewContentFromText(duplicateToolFallbackText(duplicates, results), genai.RoleModel),
+		FinishReason: genai.FinishReasonStop,
+	}, nil
+}
+
+func (g *duplicateToolCallGuard) invocation(invocationID string) *duplicateToolInvocation {
+	now := time.Now()
+	for id, candidate := range g.invocations {
+		if id != invocationID && now.Sub(candidate.lastSeen) > duplicateToolStateTTL {
+			delete(g.invocations, id)
+		}
+	}
+	state := g.invocations[invocationID]
+	if state == nil {
+		state = &duplicateToolInvocation{signatures: make(map[string]bool)}
+		g.invocations[invocationID] = state
+	}
+	state.lastSeen = now
+	return state
+}
+
+func (g *duplicateToolCallGuard) forget(invocationID string) {
+	g.mu.Lock()
+	delete(g.invocations, invocationID)
+	g.mu.Unlock()
+}
+
+func functionCallSignatures(content *genai.Content) map[string]string {
+	out := make(map[string]string)
+	if content == nil {
+		return out
+	}
+	for _, part := range content.Parts {
+		if part == nil || part.FunctionCall == nil {
+			continue
+		}
+		if signature, ok := functionCallSignature(part.FunctionCall.Name, part.FunctionCall.Args); ok {
+			out[signature] = part.FunctionCall.Name
+		}
+	}
+	return out
+}
+
+func functionCallSignature(name string, args map[string]any) (string, bool) {
+	raw, err := json.Marshal(args)
+	if err != nil {
+		return "", false
+	}
+	return name + "\x00" + string(raw), true
+}
+
+func functionResponses(contents []*genai.Content) []toolResult {
+	// Only retain the most recent tool-response content. LLMRequest.Contents may
+	// contain responses from older user turns, which must not leak into a
+	// fallback generated for the current tool round.
+	for index := len(contents) - 1; index >= 0; index-- {
+		content := contents[index]
+		if content == nil {
+			continue
+		}
+		var results []toolResult
+		for _, part := range content.Parts {
+			if part == nil {
+				continue
+			}
+			if response := part.FunctionResponse; response != nil {
+				results = append(results, toolResult{Name: response.Name, Response: response.Response})
+			}
+		}
+		if len(results) > 0 {
+			return results
+		}
+	}
+	return nil
+}
+
+type toolResult struct {
+	Name     string
+	Response map[string]any
+}
+
+func duplicateToolFallbackText(duplicates []string, results []toolResult) string {
+	var builder strings.Builder
+	builder.WriteString("Stopped a duplicate tool-call loop after the original calls completed. ")
+	if hasContextTool(duplicates) {
+		builder.WriteString("Context source unavailable. ")
+	} else {
+		builder.WriteString("One requested source was unavailable. ")
+	}
+	if len(results) == 0 {
+		builder.WriteString("No successful tool result was available.")
+		return builder.String()
+	}
+	builder.WriteString("Available tool results: ")
+	for index, result := range results {
+		if index > 0 {
+			builder.WriteString("; ")
+		}
+		raw, err := json.Marshal(result.Response)
+		if err != nil {
+			raw = []byte(fmt.Sprint(result.Response))
+		}
+		builder.WriteString(result.Name)
+		builder.WriteString("=")
+		builder.Write(raw)
+		if builder.Len() >= duplicateToolResultLimit {
+			builder.WriteString(" [truncated]")
+			break
+		}
+	}
+	text := builder.String()
+	if len(text) > duplicateToolResultLimit {
+		return text[:duplicateToolResultLimit] + " [truncated]"
+	}
+	return text
+}
+
+func hasContextTool(names []string) bool {
+	for _, name := range names {
+		lower := strings.ToLower(name)
+		if strings.Contains(lower, "context") || strings.Contains(lower, "chunk") || strings.Contains(lower, "rag") {
+			return true
+		}
+	}
+	return false
+}
