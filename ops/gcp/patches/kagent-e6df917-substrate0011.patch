+package agent
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/go-logr/logr"
+	adkagent "google.golang.org/adk/v2/agent"
+	adkmodel "google.golang.org/adk/v2/model"
+	"google.golang.org/genai"
+)
+
+type duplicateGuardContext struct {
+	adkagent.ContextMock
+	invocationID string
+}
+
+func (c *duplicateGuardContext) InvocationID() string { return c.invocationID }
+
+func TestDuplicateToolCallGuardStopsExactRetryAndPreservesResults(t *testing.T) {
+	args := map[string]any{"user_id": float64(1001), "top_k": float64(1)}
+	ctx := &duplicateGuardContext{invocationID: "invocation-1"}
+	calls := &adkmodel.LLMResponse{Content: &genai.Content{Role: genai.RoleModel, Parts: []*genai.Part{
+		genai.NewPartFromFunctionCall("get_chunk_by_id", map[string]any{"chunk_id": "missing"}),
+		genai.NewPartFromFunctionCall("get_personalized_recommendations", args),
+	}}}
+
+	guard := newDuplicateToolCallGuard(logr.Discard())
+	if replacement, err := guard.AfterModel(ctx, calls, nil); err != nil || replacement != nil {
+		t.Fatalf("first call replacement=%#v err=%v, want pass-through", replacement, err)
+	}
+	request := &adkmodel.LLMRequest{Contents: []*genai.Content{{Role: genai.RoleUser, Parts: []*genai.Part{
+		genai.NewPartFromFunctionResponse("get_chunk_by_id", map[string]any{"isError": true, "content": "not found"}),
+		genai.NewPartFromFunctionResponse("get_personalized_recommendations", map[string]any{"items": []any{map[string]any{"item_id": float64(800078)}}}),
+	}}}}
+	if replacement, err := guard.BeforeModel(ctx, request); err != nil || replacement != nil {
+		t.Fatalf("before model replacement=%#v err=%v, want capture only", replacement, err)
+	}
+	replacement, err := guard.AfterModel(ctx, calls, nil)
+	if err != nil {
+		t.Fatalf("guard returned error: %v", err)
+	}
+	if replacement == nil || replacement.Content == nil || len(replacement.Content.Parts) != 1 {
+		t.Fatalf("replacement = %#v, want terminal text response", replacement)
+	}
+	text := replacement.Content.Parts[0].Text
+	if !strings.Contains(text, "Context source unavailable") || !strings.Contains(text, "800078") {
+		t.Fatalf("fallback text = %q, want unavailable source and preserved recommendation", text)
+	}
+}
+
+func TestDuplicateToolCallGuardAllowsFirstCallAndDifferentArgs(t *testing.T) {
+	ctx := &duplicateGuardContext{invocationID: "invocation-1"}
+	guard := newDuplicateToolCallGuard(logr.Discard())
+	first := &adkmodel.LLMResponse{Content: genai.NewContentFromFunctionCall("lookup", map[string]any{"id": "old"}, genai.RoleModel)}
+	if replacement, err := guard.AfterModel(ctx, first, nil); err != nil || replacement != nil {
+		t.Fatalf("first call replacement=%#v err=%v, want pass-through", replacement, err)
+	}
+	for _, args := range []map[string]any{{"id": "new"}, {"id": "same"}} {
+		response := &adkmodel.LLMResponse{Content: genai.NewContentFromFunctionCall("lookup", args, genai.RoleModel)}
+		replacement, err := guard.AfterModel(ctx, response, nil)
+		if err != nil || replacement != nil {
+			t.Fatalf("args=%v: replacement=%#v err=%v, want pass-through", args, replacement, err)
+		}
+	}
+}
diff --git a/go/adk/pkg/agent/explicit_tool_selection_guard.go b/go/adk/pkg/agent/explicit_tool_selection_guard.go
new file mode 100644
index 00000000..1c44b314
--- /dev/null
+++ b/go/adk/pkg/agent/explicit_tool_selection_guard.go
@@ -0,0 +1,289 @@
+// Copyright 2026 The Kagent Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package agent
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"sync"
+
+	"github.com/go-logr/logr"
+	adkagent "google.golang.org/adk/v2/agent"
+	adkmodel "google.golang.org/adk/v2/model"
+	"google.golang.org/genai"
+)
+
+var coordinatorSelectableTools = []string{
+	"kagent__NS__recsys_context_agent_sandbox",
+	"kagent__NS__recsys_recommendation_agent_sandbox",
+	"get_chunk_by_id",
+	"get_personalized_recommendations",
+}
+
+type explicitToolSelection struct {
+	allowed map[string]bool
+	prompt  string
+	seen    map[string]bool
+	results []toolResult
+}
+
+// explicitToolSelectionGuard makes explicit coordinator smoke/API contracts
+// deterministic on small models. If the current user turn names one or more
+// Agent tools, only those Agent tools may execute. Otherwise, explicitly named
+// raw MCP tools are allowed. Turns that do not name a tool are left untouched.
+type explicitToolSelectionGuard struct {
+	log        logr.Logger
+	mu         sync.Mutex
+	selections map[string]explicitToolSelection
+}
+
+func newExplicitToolSelectionGuard(log logr.Logger) *explicitToolSelectionGuard {
+	return &explicitToolSelectionGuard{
+		log:        log,
+		selections: make(map[string]explicitToolSelection),
+	}
+}
+
+func (g *explicitToolSelectionGuard) BeforeModel(ctx adkagent.Context, req *adkmodel.LLMRequest) (*adkmodel.LLMResponse, error) {
+	if ctx == nil || req == nil || ctx.InvocationID() == "" {
+		return nil, nil
+	}
+	prompt := latestUserText(req.Contents)
+	if prompt == "" {
+		return nil, nil
+	}
+	allowed := make(map[string]bool)
+	for _, name := range coordinatorSelectableTools[:2] {
+		if strings.Contains(prompt, name) {
+			allowed[name] = true
+		}
+	}
+	if len(allowed) == 0 {
+		for _, name := range coordinatorSelectableTools[2:] {
+			if strings.Contains(prompt, name) {
+				allowed[name] = true
+			}
+		}
+	}
+	g.mu.Lock()
+	if len(allowed) == 0 {
+		delete(g.selections, ctx.InvocationID())
+	} else {
+		selection, exists := g.selections[ctx.InvocationID()]
+		if !exists || selection.prompt != prompt {
+			selection = explicitToolSelection{
+				allowed: allowed,
+				prompt:  prompt,
+				seen:    make(map[string]bool),
+			}
+		} else {
+			selection.allowed = allowed
+		}
+		if results := functionResponses(req.Contents); len(results) > 0 {
+			selection.results = mergeToolResults(selection.results, results)
+		}
+		g.selections[ctx.InvocationID()] = selection
+	}
+	g.mu.Unlock()
+	return nil, nil
+}
+
+func (g *explicitToolSelectionGuard) AfterModel(ctx adkagent.Context, resp *adkmodel.LLMResponse, modelErr error) (*adkmodel.LLMResponse, error) {
+	if ctx == nil || ctx.InvocationID() == "" {
+		return nil, nil
+	}
+	invocationID := ctx.InvocationID()
+	if modelErr != nil || resp == nil {
+		g.forget(invocationID)
+		return nil, nil
+	}
+	if resp.Partial || resp.Content == nil {
+		return nil, nil
+	}
+
+	g.mu.Lock()
+	selection, selected := g.selections[invocationID]
+	g.mu.Unlock()
+	if !selected {
+		return nil, nil
+	}
+
+	filtered := make([]*genai.Part, 0, len(resp.Content.Parts))
+	removed := make([]string, 0)
+	allowedCalls := 0
+	for _, part := range resp.Content.Parts {
+		if part == nil || part.FunctionCall == nil {
+			filtered = append(filtered, part)
+			continue
+		}
+		if selection.allowed[part.FunctionCall.Name] && !selection.seen[part.FunctionCall.Name] {
+			allowedCalls++
+			selection.seen[part.FunctionCall.Name] = true
+			filtered = append(filtered, part)
+		} else {
+			removed = append(removed, part.FunctionCall.Name)
+		}
+	}
+	g.mu.Lock()
+	g.selections[invocationID] = selection
+	g.mu.Unlock()
+	if len(removed) == 0 {
+		if allowedCalls == 0 {
+			if text, ok := partialResultText(selection); ok {
+				g.forget(invocationID)
+				return &adkmodel.LLMResponse{
+					Content:      genai.NewContentFromText(text, genai.RoleModel),
+					FinishReason: genai.FinishReasonStop,
+				}, nil
+			}
+			g.forget(invocationID)
+		}
+		return nil, nil
+	}
+
+	g.log.Info("Filtered tool calls outside explicit coordinator selection",
+		"invocationID", invocationID, "removedTools", removed)
+	if allowedCalls == 0 {
+		for name := range selection.allowed {
+			if selection.seen[name] {
+				continue
+			}
+			if strings.HasPrefix(name, "kagent__NS__") {
+				selection.seen[name] = true
+				g.mu.Lock()
+				g.selections[invocationID] = selection
+				g.mu.Unlock()
+				return &adkmodel.LLMResponse{
+					Content: genai.NewContentFromFunctionCall(
+						name, map[string]any{"request": missingAgentRequest(selection)}, genai.RoleModel,
+					),
+				}, nil
+			}
+		}
+		g.forget(invocationID)
+		return &adkmodel.LLMResponse{
+			Content:      genai.NewContentFromText(duplicateToolFallbackText(removed, selection.results), genai.RoleModel),
+			FinishReason: genai.FinishReasonStop,
+		}, nil
+	}
+
+	replacement := *resp
+	content := *resp.Content
+	content.Parts = filtered
+	replacement.Content = &content
+	return &replacement, nil
+}
+
+func mergeToolResults(existing, incoming []toolResult) []toolResult {
+	merged := append([]toolResult(nil), existing...)
+	for _, candidate := range incoming {
+		replaced := false
+		for index := range merged {
+			if merged[index].Name == candidate.Name {
+				merged[index] = candidate
+				replaced = true
+				break
+			}
+		}
+		if !replaced {
+			merged = append(merged, candidate)
+		}
+	}
+	return merged
+}
+
+func partialResultText(selection explicitToolSelection) (string, bool) {
+	if len(selection.allowed) != 2 ||
+		!selection.allowed["get_chunk_by_id"] ||
+		!selection.allowed["get_personalized_recommendations"] ||
+		!selection.seen["get_chunk_by_id"] ||
+		!selection.seen["get_personalized_recommendations"] {
+		return "", false
+	}
+	contextFailed := false
+	itemID := ""
+	for _, result := range selection.results {
+		switch result.Name {
+		case "get_chunk_by_id":
+			_, contextFailed = result.Response["error"]
+		case "get_personalized_recommendations":
+			if id, ok := firstItemID(result.Response); ok {
+				itemID = id
+			}
+		}
+	}
+	if !contextFailed || itemID == "" {
+		return "", false
+	}
+	return "Recommended item_id: " + itemID + ". Context source unavailable.", true
+}
+
+func firstItemID(value any) (string, bool) {
+	switch typed := value.(type) {
+	case map[string]any:
+		if id, ok := typed["item_id"]; ok && id != nil {
+			return fmt.Sprint(id), true
+		}
+		for _, child := range typed {
+			if id, ok := firstItemID(child); ok {
+				return id, true
+			}
+		}
+	case []any:
+		for _, child := range typed {
+			if id, ok := firstItemID(child); ok {
+				return id, true
+			}
+		}
+	}
+	return "", false
+}
+
+func missingAgentRequest(selection explicitToolSelection) string {
+	resultText := "none"
+	if raw, err := json.Marshal(selection.results); err == nil && len(raw) > 0 {
+		resultText = string(raw)
+	}
+	return "Continue the explicitly requested coordinator flow without repeating a completed tool. " +
+		"Use these completed tool results to preserve user_id, item order, and returned item IDs: " +
+		resultText + ". Original request: " + selection.prompt
+}
+
+func (g *explicitToolSelectionGuard) forget(invocationID string) {
+	g.mu.Lock()
+	delete(g.selections, invocationID)
+	g.mu.Unlock()
+}
+
+func latestUserText(contents []*genai.Content) string {
+	for index := len(contents) - 1; index >= 0; index-- {
+		content := contents[index]
+		if content == nil || content.Role != genai.RoleUser {
+			continue
+		}
+		var text strings.Builder
+		for _, part := range content.Parts {
+			if part != nil && part.Text != "" {
+				text.WriteString(part.Text)
+				text.WriteByte('\n')
+			}
+		}
+		if text.Len() > 0 {
+			return text.String()
+		}
+	}
+	return ""
+}
