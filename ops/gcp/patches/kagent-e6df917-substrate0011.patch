+package agent
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/go-logr/logr"
+	adkagent "google.golang.org/adk/v2/agent"
+	adkmodel "google.golang.org/adk/v2/model"
+	"google.golang.org/genai"
+)
+
+type duplicateGuardContext struct {
+	adkagent.ContextMock
+	invocationID string
+}
+
+func (c *duplicateGuardContext) InvocationID() string { return c.invocationID }
+
+func TestDuplicateToolCallGuardStopsExactRetryAndPreservesResults(t *testing.T) {
+	args := map[string]any{"user_id": float64(1001), "top_k": float64(1)}
+	ctx := &duplicateGuardContext{invocationID: "invocation-1"}
+	calls := &adkmodel.LLMResponse{Content: &genai.Content{Role: genai.RoleModel, Parts: []*genai.Part{
+		genai.NewPartFromFunctionCall("get_chunk_by_id", map[string]any{"chunk_id": "missing"}),
+		genai.NewPartFromFunctionCall("get_personalized_recommendations", args),
+	}}}
+
+	guard := newDuplicateToolCallGuard(logr.Discard())
+	if replacement, err := guard.AfterModel(ctx, calls, nil); err != nil || replacement != nil {
+		t.Fatalf("first call replacement=%#v err=%v, want pass-through", replacement, err)
+	}
+	request := &adkmodel.LLMRequest{Contents: []*genai.Content{{Role: genai.RoleUser, Parts: []*genai.Part{
+		genai.NewPartFromFunctionResponse("get_chunk_by_id", map[string]any{"isError": true, "content": "not found"}),
+		genai.NewPartFromFunctionResponse("get_personalized_recommendations", map[string]any{"items": []any{map[string]any{"item_id": float64(800078)}}}),
+	}}}}
+	if replacement, err := guard.BeforeModel(ctx, request); err != nil || replacement != nil {
+		t.Fatalf("before model replacement=%#v err=%v, want capture only", replacement, err)
+	}
+	replacement, err := guard.AfterModel(ctx, calls, nil)
+	if err != nil {
+		t.Fatalf("guard returned error: %v", err)
+	}
+	if replacement == nil || replacement.Content == nil || len(replacement.Content.Parts) != 1 {
+		t.Fatalf("replacement = %#v, want terminal text response", replacement)
+	}
+	text := replacement.Content.Parts[0].Text
+	if !strings.Contains(text, "Context source unavailable") || !strings.Contains(text, "800078") {
+		t.Fatalf("fallback text = %q, want unavailable source and preserved recommendation", text)
+	}
+}
+
+func TestDuplicateToolCallGuardAllowsFirstCallAndDifferentArgs(t *testing.T) {
+	ctx := &duplicateGuardContext{invocationID: "invocation-1"}
+	guard := newDuplicateToolCallGuard(logr.Discard())
+	first := &adkmodel.LLMResponse{Content: genai.NewContentFromFunctionCall("lookup", map[string]any{"id": "old"}, genai.RoleModel)}
+	if replacement, err := guard.AfterModel(ctx, first, nil); err != nil || replacement != nil {
+		t.Fatalf("first call replacement=%#v err=%v, want pass-through", replacement, err)
+	}
+	for _, args := range []map[string]any{{"id": "new"}, {"id": "same"}} {
+		response := &adkmodel.LLMResponse{Content: genai.NewContentFromFunctionCall("lookup", args, genai.RoleModel)}
+		replacement, err := guard.AfterModel(ctx, response, nil)
+		if err != nil || replacement != nil {
+			t.Fatalf("args=%v: replacement=%#v err=%v, want pass-through", args, replacement, err)
+		}
+	}
+}
diff --git a/go/adk/pkg/agent/explicit_tool_selection_guard.go b/go/adk/pkg/agent/explicit_tool_selection_guard.go
